spring.application.name=quizcit-backend
spring.datasource.url=${QUIZCIT_DB_URL:jdbc:postgresql://localhost:5432/postgres?prepareThreshold=0}
spring.datasource.username=${QUIZCIT_DB_USERNAME:postgres}
spring.datasource.password=${QUIZCIT_DB_PASSWORD:your_db_password}
spring.datasource.driver-class-name=org.postgresql.Driver

quizcit.auth.token.secret=${QUIZCIT_AUTH_TOKEN_SECRET:quizcit-local-token-secret-change-me}
quizcit.auth.token.expiration-seconds=${QUIZCIT_AUTH_TOKEN_EXPIRATION_SECONDS:900}
quizcit.auth.refresh-token.expiration-seconds=${QUIZCIT_AUTH_REFRESH_TOKEN_EXPIRATION_SECONDS:2592000}
quizcit.ai.base-url=${QUIZCIT_AI_BASE_URL:http://localhost:8000}

spring.mail.host=${QUIZCIT_MAIL_HOST:smtp.resend.com}
spring.mail.port=${QUIZCIT_MAIL_PORT:587}
spring.mail.username=${QUIZCIT_MAIL_USERNAME:resend}
spring.mail.password=${QUIZCIT_MAIL_PASSWORD:your_mail_password}
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true
quizcit.auth.otp.from-address=${QUIZCIT_MAIL_FROM:no-reply@example.com}
quizcit.auth.otp.token-secret=${QUIZCIT_OTP_TOKEN_SECRET:quizcit-local-otp-secret-change-me}
quizcit.auth.otp.expiration-seconds=${QUIZCIT_OTP_EXPIRATION_SECONDS:300}

quizcit.upload.dir=${QUIZCIT_UPLOAD_DIR:uploads}
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=10MB

# Redis Cache Configuration
spring.data.redis.host=${QUIZCIT_REDIS_HOST:localhost}
spring.data.redis.port=${QUIZCIT_REDIS_PORT:6379}
spring.data.redis.password=${QUIZCIT_REDIS_PASSWORD:}
spring.data.redis.timeout=2000ms
spring.data.redis.lettuce.pool.max-active=16
spring.data.redis.lettuce.pool.max-idle=8
spring.data.redis.lettuce.pool.min-idle=2
spring.cache.type=redis
